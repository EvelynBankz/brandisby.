# Copy to .env and fill in for local development. Never commit .env.
#
# DATABASE_URL: a PostgreSQL connection string. For local development this
# can point at any local Postgres (see docs/roadmap.md M0.2 notes). For the
# real environment, create a Neon project (https://neon.tech) and use its
# connection string here — never the existing Firebase project.
DATABASE_URL="postgresql://user:password@localhost:5432/brandisby_dev?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Authentication — the EXISTING "brandisby" Firebase project, reused
# for identity only (never Firestore/Storage; Postgres stays the database).
#
# For local dev/tests, keep every Firebase value as the "demo-brandisby" fake
# project shown below + the Auth emulator (`npm run test` starts it
# automatically; `npm run dev` needs it running separately, see README).
# Client and server MUST use the SAME project id — the emulator isolates data
# per project, so a mismatch silently breaks token verification.
FIREBASE_PROJECT_ID="demo-brandisby"
# Server-side Admin SDK emulator flag — separate from the NEXT_PUBLIC_ one
# below (that one only affects the browser bundle). Both are required for
# `npm run dev` to work against the emulator; `npm run test` sets this one
# automatically via `firebase emulators:exec`.
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="demo-brandisby.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="demo-brandisby"
NEXT_PUBLIC_FIREBASE_APP_ID="demo-app-id"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# --- Real (production) Firebase values — replace ALL of the above with these ---
# The NEXT_PUBLIC_ ones are public/non-secret; copy them from the Firebase
# console (Project settings > General > Your apps), same values already
# embedded in the legacy site's js/firebase-config.js.
# FIREBASE_PROJECT_ID="brandisby"
# NEXT_PUBLIC_FIREBASE_API_KEY="..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="brandisby.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="brandisby"
# NEXT_PUBLIC_FIREBASE_APP_ID="..."
# (leave FIREBASE_AUTH_EMULATOR_HOST and NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST unset)
#
# FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY are secret — only needed outside
# the emulator. Get them from a service account scoped to Firebase
# Authentication Admin only (not Firestore/Datastore) — see
# docs/decisions/002-firebase-auth-instead-of-clerk.md.
# FIREBASE_CLIENT_EMAIL="service-account@brandisby.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
