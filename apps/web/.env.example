# Copy to .env and fill in for local development. Never commit .env.
#
# DATABASE_URL: a PostgreSQL connection string. For local development this
# can point at any local Postgres (see docs/roadmap.md M0.2 notes). For the
# real environment, create a Neon project (https://neon.tech) and use its
# connection string here — never the existing Firebase project.
DATABASE_URL="postgresql://user:password@localhost:5432/brandisby_dev?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Authentication — the EXISTING "brandisby" Firebase project, reused
# for identity only (never Firestore/Storage; Postgres stays the database).
# For local dev/tests, "demo-brandisby" + the Auth emulator (`npm run test`
# wraps it automatically) needs no real credentials at all.
FIREBASE_PROJECT_ID="demo-brandisby"
# Only needed outside the emulator, i.e. against the real Firebase project.
# Get these from a service account scoped to Firebase Authentication Admin
# only (not Firestore/Datastore) — see docs/decisions/002-firebase-auth.md.
# FIREBASE_CLIENT_EMAIL="service-account@brandisby.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
