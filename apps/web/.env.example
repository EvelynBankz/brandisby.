# Copy to .env and fill in for local development. Never commit .env.

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase (Firestore + Auth) — the EXISTING "brandisby" Firebase project.
# Firestore is the main database; Auth is for internal/admin login only
# (no public reader accounts in V1). No Firebase Storage yet — image URLs
# only for now, structured so Storage can be added later without a rebuild.
#
# For local dev/tests, keep every value as the "demo-brandisby" fake project
# shown below + the Auth/Firestore emulators (`npm run test` starts them
# automatically; `npm run dev` needs them running separately, see README).
# Client and server MUST use the SAME project id — the emulator isolates
# data per project, so a mismatch silently breaks things.
FIREBASE_PROJECT_ID="demo-brandisby"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="demo-brandisby.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="demo-brandisby"
NEXT_PUBLIC_FIREBASE_APP_ID="demo-app-id"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# --- Real (production) Firebase values — replace ALL of the above with these ---
# The NEXT_PUBLIC_ ones are public/non-secret; copy them from the Firebase
# console (Project settings > General > Your apps), same values already
# embedded in the legacy site's js/firebase-config.js.
# FIREBASE_PROJECT_ID="brandisby"
# NEXT_PUBLIC_FIREBASE_API_KEY="..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="brandisby.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="brandisby"
# NEXT_PUBLIC_FIREBASE_APP_ID="..."
# (leave every *_EMULATOR_HOST var unset)
#
# FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY are secret — only needed outside
# the emulator. Get them from a service account scoped narrowly (Firestore +
# Firebase Authentication Admin), not a broad Owner/Editor role.
# FIREBASE_CLIENT_EMAIL="service-account@brandisby.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
